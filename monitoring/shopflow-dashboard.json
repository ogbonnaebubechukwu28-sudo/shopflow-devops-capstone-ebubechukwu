{
"uid":"shopflow-overview",
"title":"ShopFlow Overview",
"tags":["shopflow"],
"timezone":"browser",
"schemaVersion":39,
"version":1,
"refresh":"30s",
"time":{"from":"now-1h","to":"now"},
"panels":[
{"id":1,"title":"Request rate by status code","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"refId":"A","expr":"sum by (status) (rate(flask_http_request_total{namespace='shopflow'}[1m]))","legendFormat":"{{status}}","datasource":{"type":"prometheus","uid":"prometheus"}}],"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"description":"Requests per second handled by the backend, split by HTTP status."},
{"id":2,"title":"HTTP 5xx error ratio","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"refId":"A","expr":"sum(rate(flask_http_request_total{namespace='shopflow',status=~'5..'}[2m])) / clamp_min(sum(rate(flask_http_request_total{namespace='shopflow'}[2m])), 0.0001)","legendFormat":"5xx ratio","datasource":{"type":"prometheus","uid":"prometheus"}}],"fieldConfig":{"defaults":{"unit":"percentunit"},"overrides":[]},"description":"Share of requests failing with a server error. BackendHighErrorRate fires above 5%."},
{"id":3,"title":"Latency p95 and p50 (seconds)","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":8,"w":12,"h":8},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le) (rate(flask_http_request_duration_seconds_bucket{namespace='shopflow'}[5m])))","legendFormat":"p95","datasource":{"type":"prometheus","uid":"prometheus"}},{"refId":"B","expr":"histogram_quantile(0.50, sum by (le) (rate(flask_http_request_duration_seconds_bucket{namespace='shopflow'}[5m])))","legendFormat":"p50","datasource":{"type":"prometheus","uid":"prometheus"}}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"description":"Request latency percentiles. BackendHighLatency fires when p95 is above 1s."},
{"id":4,"title":"Container restarts (total)","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"refId":"A","expr":"sum by (pod) (kube_pod_container_status_restarts_total{namespace='shopflow'})","legendFormat":"{{pod}}","datasource":{"type":"prometheus","uid":"prometheus"}}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"description":"Cumulative restarts per pod (kube-state-metrics)."},
{"id":5,"title":"CPU usage per pod (cores)","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":16,"w":12,"h":8},"targets":[{"refId":"A","expr":"sum by (pod) (rate(container_cpu_usage_seconds_total{namespace='shopflow',container!=''}[2m]))","legendFormat":"{{pod}}","datasource":{"type":"prometheus","uid":"prometheus"}}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"description":"CPU from cAdvisor."},
{"id":6,"title":"Memory working set per pod","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":16,"w":12,"h":8},"targets":[{"refId":"A","expr":"sum by (pod) (container_memory_working_set_bytes{namespace='shopflow',container!=''})","legendFormat":"{{pod}}","datasource":{"type":"prometheus","uid":"prometheus"}}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]},"description":"Memory from cAdvisor."},
{"id":7,"title":"Available vs desired replicas","type":"stat","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":24,"w":6,"h":5},"targets":[{"refId":"A","expr":"sum(kube_deployment_status_replicas_available{namespace='shopflow'})","legendFormat":"available","datasource":{"type":"prometheus","uid":"prometheus"}},{"refId":"B","expr":"sum(kube_deployment_spec_replicas{namespace='shopflow'})","legendFormat":"desired","datasource":{"type":"prometheus","uid":"prometheus"}}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"description":"Workload health across all ShopFlow deployments."},
{"id":8,"title":"Pods not ready","type":"stat","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":6,"y":24,"w":6,"h":5},"targets":[{"refId":"A","expr":"sum(kube_pod_status_ready{namespace='shopflow',condition='false'}) or vector(0)","legendFormat":"not ready","datasource":{"type":"prometheus","uid":"prometheus"}}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"description":"Number of ShopFlow pods that are not Ready."},
{"id":9,"title":"Firing alerts","type":"stat","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":24,"w":6,"h":5},"targets":[{"refId":"A","expr":"count(ALERTS{alertstate='firing'}) or vector(0)","legendFormat":"firing","datasource":{"type":"prometheus","uid":"prometheus"}}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"description":"Alerts currently firing in Prometheus."},
{"id":10,"title":"Backend pods scraped (up)","type":"stat","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":18,"y":24,"w":6,"h":5},"targets":[{"refId":"A","expr":"sum(up{namespace='shopflow',app_kubernetes_io_name='backend'}) or vector(0)","legendFormat":"up","datasource":{"type":"prometheus","uid":"prometheus"}}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"description":"Backend pods Prometheus can scrape."}
]
}
